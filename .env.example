# --- LLM: anthropic | openai | groq (leave model blank for provider default) ---
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_FAST_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Embeddings: huggingface (local, free) | openai ---
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=

# --- Chroma ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=tech_docs

# --- PostgreSQL ---
POSTGRES_URL=postgresql://rag:rag@localhost:5432/rag

# --- Ingestion / retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
HYBRID_ALPHA=0.5

# --- Conversation memory: sliding_window | summary_buffer ---
MEMORY_STRATEGY=summary_buffer
WINDOW_SIZE=6
SUMMARY_THRESHOLD=10
COMPRESSION_RATIO=0.3

API_URL=http://localhost:8080
